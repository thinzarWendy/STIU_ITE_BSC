{
  "info": {
    "name": "CSC220 Student API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "studentId",
      "value": "PASTE_ID_HERE"
    },
    {
      "key": "deletedId",
      "value": "DELETED_ID_HERE"
    }
  ],
  "item": [
    {
      "name": "Test 1 - GET all students",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Test 2 - GET one student",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Test 3 - POST create student",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Nora\",\n  \"major\": \"CS\",\n  \"score\": 88\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Test 4 - POST validation error",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"major\": \"IT\",\n  \"score\": 75\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students"
          ]
        }
      }
    },
    {
      "name": "Test 5 - PATCH update student",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 95\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Test 6 - PATCH invalid score",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"score\": 5000\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Test 7 - DELETE student",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "{{baseUrl}}/api/students/{{studentId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{studentId}}"
          ]
        }
      }
    },
    {
      "name": "Test 8 - GET deleted student again",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/students/{{deletedId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "students",
            "{{deletedId}}"
          ]
        }
      }
    },
    {
      "name": "Test 9 - Wrong route",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/wrong-url",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "wrong-url"
          ]
        }
      }
    }
  ]
}
